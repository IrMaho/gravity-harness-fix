{
  "gravity-harness-fix-guards": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "hooks\\run_hook.cmd SessionStart",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": "manage_task|run_command|read_file|view_file|edit_file|replace_file_content|multi_replace_file_content|invoke_subagent",
        "hooks": [
          {
            "type": "command",
            "command": "hooks\\run_hook.cmd PreToolUse",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "hooks\\run_hook.cmd PostToolUse",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "hooks\\run_hook.cmd Stop",
        "timeout": 5
      }
    ]
  }
}
